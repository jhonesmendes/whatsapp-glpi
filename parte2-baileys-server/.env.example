# ============================================================
# Servidor Baileys — Configuração
# Copie este arquivo para .env e preencha os valores
# ============================================================

# Porta onde o servidor vai escutar (deve ser acessível pelo servidor GLPI)
PORT=3333

# Token secreto para autenticar as requisições entre GLPI e este servidor
# Deve ser IDÊNTICO ao "Token de autenticação" configurado no plugin GLPI
BOT_TOKEN=TROQUE_POR_UM_TOKEN_SECRETO_FORTE

# URL do webhook no servidor GLPI
# Este servidor vai fazer POST nesta URL quando receber mensagens do WhatsApp
GLPI_WEBHOOK_URL=https://SEU_GLPI/plugins/whatsappbot/webhook.php

# Nome da pasta onde as sessões do WhatsApp ficam salvas
# Mantenha como está — não precisa alterar
SESSION_DIR=./sessions

# Nível de log: trace | debug | info | warn | error
LOG_LEVEL=info

# Número de tentativas de reconexão automática antes de alertar
MAX_RECONNECT=5

# Tamanho máximo (em bytes) de imagem/documento aceito como anexo de
# chamado. Acima disso, o anexo é descartado (a legenda/descrição ainda
# é processada normalmente). Padrão: 5MB — hospedagens compartilhadas de
# GLPI costumam ter post_max_size baixo (8MB é comum), e o base64 usado
# para enviar o arquivo já soma ~33% a mais que o tamanho original.
MAX_MEDIA_BYTES=5242880
