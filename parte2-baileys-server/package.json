{
  "name": "whatsappbot-baileys-server",
  "version": "1.0.0",
  "description": "Servidor WhatsApp Web (Baileys) para integração com GLPI",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "pm2:start": "pm2 start src/index.js --name whatsapp-bot --restart-delay=3000 --max-restarts=10",
    "pm2:stop": "pm2 stop whatsapp-bot",
    "pm2:logs": "pm2 logs whatsapp-bot"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "express": "^4.18.2",
    "dotenv": "^16.4.5",
    "axios": "^1.6.7",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "pino": "^8.21.0",
    "pino-pretty": "^11.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
